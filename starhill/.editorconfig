root = true

[*]
indent_style = space
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
# CA1716: type 'Error' trùng keyword VB. Base chỉ dùng C# (không VB-interop); 'Error' là tên
# idiomatic của Result pattern (ErrorOr/FluentResults). Cố ý giữ — đổi tên chỉ làm khó đọc.
dotnet_diagnostic.CA1716.severity = none
# CA1000: "không đặt static member trên generic type". Result<T>.Success(value)/Failure(error) là
# factory CHỦ ĐÍCH theo design.md §4.4 (đã chốt AD-002) — cách duy nhất tạo Result<T> hợp lệ mà vẫn
# suy luận được kiểu T từ tham số. Đây là pattern chuẩn của Result/ErrorOr, không phải static API
# chung nên rủi ro CA1000 (khó gọi qua kiểu dẫn xuất) không áp dụng. Suppress có chủ đích.
dotnet_diagnostic.CA1000.severity = none
# Naming convention: interface I*.
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

# Project test: cho phép tên test có underscore (Method_should_do_x).
# CA1707 dành cho public API surface, không áp cho tên method test.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core migration = CODE SINH TỰ ĐỘNG (dotnet ef migrations). KHÔNG hand-edit để thỏa style/quality analyzer
# (sửa tay = fragile; regenerate sẽ mất). Đánh dấu generated_code → analyzer bỏ qua (vd CA1861 với composite
# index `new[]{...}` EF sinh). Chính sách áp cho MỌI module (Identity/ResortConfig/Rooms/... về sau).
[**/Persistence/Migrations/*.cs]
generated_code = true

[*.{json,xml,props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
