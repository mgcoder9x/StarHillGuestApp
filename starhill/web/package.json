{
  "name": "starhill-web",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:guest": "pnpm --filter @starhill/guest-web dev",
    "dev:admin": "pnpm --filter @starhill/admin-web dev",
    "build:guest": "pnpm --filter @starhill/guest-web build",
    "build:admin": "pnpm --filter @starhill/admin-web build",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter @starhill/e2e test"
  }
}
