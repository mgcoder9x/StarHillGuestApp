<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Identity.Infrastructure (persistence + composition nửa-Infra — matrix §3.3): reference Identity.Application
    + Bedrock.Infrastructure. KHÔNG ref Bedrock.Api hay Identity.Api (giữ Api⊥Infra — I7; DV-013). Nửa-Api
    (IEndpointModule) ở Identity.Api; Host ráp hai nửa.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Identity.Application\Identity.Application.csproj" />
    <ProjectReference Include="$(PlatformSrc)\Bedrock.Infrastructure\Bedrock.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Design-time: IDesignTimeDbContextFactory cho `dotnet ef migrations` (per-module §4.6). PrivateAssets=all:
         chỉ dùng lúc thiết kế/migration, KHÔNG chảy sang runtime/consumer. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
