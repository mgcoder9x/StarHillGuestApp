    <ProjectReference Include="..\..\..\StarHill.Authorization\StarHill.Authorization.csproj" />
    <ProjectReference Include="$(PlatformSrc)\Bedrock.Api\Bedrock.Api.csproj" />
  </ItemGroup>
</Project>
