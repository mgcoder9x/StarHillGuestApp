<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Host / StarHill.Api = COMPOSITION ROOT DUY NHẤT (invariant I7/luật-5): nơi DUY NHẤT được reference đồng thời
    Bedrock.Api + Bedrock.Infrastructure + Modules (Api-half + Infra-half). Không project nào khác ráp cả hai phía.
    Host CHỌN provider DB (Npgsql) + bật adapter/module nào. Không có Program.cs/endpoint nghiệp vụ trong Bedrock.*.
  -->
  <PropertyGroup>
    <!-- Secret governance (F35/task 19): dev nạp secret (Jwt.Keys[].Secret, mật khẩu DB) qua User-Secrets —
         WebApplication.CreateBuilder tự load ở môi trường Development. KHÔNG commit secret vào repo. -->
    <UserSecretsId>starhill-api-dev-8f3c1e6a</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PlatformSrc)\Bedrock.Api\Bedrock.Api.csproj" />
    <ProjectReference Include="$(PlatformSrc)\Bedrock.Infrastructure\Bedrock.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Identity.Infrastructure\Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Identity.Api\Identity.Api.csproj" />
    <!-- Module ResortConfig: nửa-Infra + nửa-Api (B-Config.3 — admin settings). Host là nơi DUY NHẤT ráp module. -->
    <ProjectReference Include="..\..\Modules\ResortConfig\ResortConfig.Infrastructure\ResortConfig.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\ResortConfig\ResortConfig.Api\ResortConfig.Api.csproj" />
    <!-- Module Rooms: nửa-Infra + nửa-Api (B-Rooms.3 — admin CRUD/QR endpoint). -->
    <ProjectReference Include="..\..\Modules\Rooms\Rooms.Infrastructure\Rooms.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Rooms\Rooms.Api\Rooms.Api.csproj" />
    <!-- Module GuestAccess: nửa-Infra (persistence + resolve) + nửa-Api (C-GA.3 — endpoint công khai resolve). -->
    <ProjectReference Include="..\..\Modules\GuestAccess\GuestAccess.Infrastructure\GuestAccess.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\GuestAccess\GuestAccess.Api\GuestAccess.Api.csproj" />
    <!-- Module Rules: nửa-Infra (persistence + use case + IRuleGate) + nửa-Api admin (D-Rules.4c — nội quy Draft/Publish). -->
    <ProjectReference Include="..\..\Modules\Rules\Rules.Infrastructure\Rules.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Rules\Rules.Api\Rules.Api.csproj" />
    <!-- Module Faq: nửa-Infra (persistence + CRUD/reorder + guest tree read) + nửa-Api (E-Faq.4 — admin CRUD + guest tree). -->
    <ProjectReference Include="..\..\Modules\Faq\Faq.Infrastructure\Faq.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Faq\Faq.Api\Faq.Api.csproj" />
    <!-- Module Housekeeping: nửa-Infra (persistence + use case) + nửa-Api (H-Hk.3 — guest tạo/xem + admin board/complete). -->
    <ProjectReference Include="..\..\Modules\Housekeeping\Housekeeping.Infrastructure\Housekeeping.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Housekeeping\Housekeeping.Api\Housekeeping.Api.csproj" />
    <!-- Adapter bảo mật IHtmlSanitizer (Ganss) dùng chung — Rules/Faq sanitize-on-save; RequirePort ở Program.cs. -->
    <ProjectReference Include="..\..\StarHill.Html\StarHill.Html.csproj" />
    <!-- Policy authorization sản phẩm (Admin/Staff superset) — Host khai role, mọi module Api tham chiếu. -->
    <ProjectReference Include="..\..\StarHill.Authorization\StarHill.Authorization.csproj" />
    <!-- Adapter công nghệ: Host (composition root) là nơi DUY NHẤT được cắm adapter (F29/CP5). Bật/tắt qua config
         Bedrock:Messaging:Enabled — bỏ adapter = quay về default fail-loud, KHÔNG sửa lõi. -->
    <ProjectReference Include="$(PlatformSrc)\Adapters\Messaging.RabbitMq\Adapters.Messaging.RabbitMq.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host chọn provider PostgreSQL (design §1.2 — Postgres là provider đích). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <!-- Smoke test boot host qua WebApplicationFactory<Program>. -->
    <InternalsVisibleTo Include="StarHill.Api.Tests" />
  </ItemGroup>
</Project>
