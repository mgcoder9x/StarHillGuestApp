{
  "name": "@bedrock/web-adapter",
  "version": "0.1.0",
  "description": "Framework-neutral async resource and external-store adapter.",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}
