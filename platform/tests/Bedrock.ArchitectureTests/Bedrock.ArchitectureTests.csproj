<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <!-- Identity.Api/Bedrock.Api dùng type ASP.NET → cần shared framework để CLR nạp được assembly khi
       NetArchTest truy cập typeof(...).Assembly (module boundary/CP5 tests). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bedrock.Domain\Bedrock.Domain.csproj" />
    <ProjectReference Include="..\..\src\Bedrock.Messaging.Contracts\Bedrock.Messaging.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Bedrock.Application\Bedrock.Application.csproj" />
    <ProjectReference Include="..\..\src\Bedrock.Infrastructure\Bedrock.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Bedrock.Api\Bedrock.Api.csproj" />
  </ItemGroup>

  <!-- Module Identity (5 project) — để arch test kiểm CP4 (module boundary) + CP5 (single composition root)
       + CP11 (use case ⊥ Messaging.Dispatch) trên module thật. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Identity\Identity.Contracts\Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Identity.Domain\Identity.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Identity.Application\Identity.Application.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Identity.Infrastructure\Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Identity.Api\Identity.Api.csproj" />
  </ItemGroup>

  <!-- Adapter mẫu (task 14) — để arch test kiểm CP3 (Adapters.* chỉ ref Bedrock.Application). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Adapters\Messaging.RabbitMq\Adapters.Messaging.RabbitMq.csproj" />
  </ItemGroup>
</Project>
