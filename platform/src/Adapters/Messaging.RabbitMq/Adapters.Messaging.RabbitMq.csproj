<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Adapter mẫu (F29, matrix §3.3): reference CHỈ Bedrock.Application (port IEventBusPublisher + OutboxMessage,
    + Domain/Messaging.Contracts bắc cầu). KHÔNG ref module/adapter khác/Bedrock.Api/Bedrock.Infrastructure —
    enforced bởi CP3 (Bedrock.ArchitectureTests/AdapterIsolationTests). SDK công nghệ (RabbitMQ.Client) +
    resilience (Microsoft.Extensions.Resilience/Polly v8) CHỈ sống ở đây (I2/§17), không rò vào lõi.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Bedrock.Application\Bedrock.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <!-- Subscriber = BackgroundService (IHostedService) + tạo scope/message + log. Hosting.Abstractions là
         abstraction chuẩn .NET (không phải ASP.NET/EF/Infra) → KHÔNG vi phạm CP3 (AdapterIsolationTests). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cho test truy cập mapper/pipeline-factory internal (verify không cần broker). -->
    <InternalsVisibleTo Include="Adapters.Messaging.RabbitMq.Tests" />
  </ItemGroup>
</Project>
