{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EF: Update Database",
      "type": "shell",
      "command": "dotnet ef database update --project ./Core/FresherDev.HMS.EntityFramework/FresherDev.HMS.EntityFramework.csproj",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "EF: Add Migration",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "ef",
        "migrations",
        "add",
        "${input:migrationName}",
        "--project",
        "./Core/FresherDev.HMS.EntityFramework/FresherDev.HMS.EntityFramework.csproj"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Enter migration name",
      "default": ""
    }
  ]
}